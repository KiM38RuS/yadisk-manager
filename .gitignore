```gitignore
# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs and temp files
*.log
*.tmp
*.swp

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Dependencies
.venv/
venv/
node_modules/

# Build artifacts
dist/
build/
target/

# Coverage reports
.coverage
coverage/
htmlcov/

# OS generated files
.DS_Store
Thumbs.db

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Coverage
.coverage*

# AI и виртуальные окружения
.claude/
.pi/

# Логи и временные файлы
*.txt
LOG.txt
Backup/**/*.txt

# Скомпилированные файлы и тесты
YaDiskManager.exe
Test/
Reference/
icon-dev/
wiki/
tests/text_*.json
```